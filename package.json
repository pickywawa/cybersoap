{
  "name": "cybersoap",
  "productName": "CyberSoap",
  "version": "1.0.0",
  "description": "Cyber-styled SOAP web service client & tester",
  "main": "src/main/main.js",
  "author": "pickywawa",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --publish never",
    "icons": "electron scripts/make-icons.js",
    "release": "vite build && electron-builder --publish always"
  },
  "build": {
    "appId": "io.github.pickywawa.cybersoap",
    "productName": "CyberSoap",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/main/**",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pickywawa",
        "repo": "cybersoap",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "CyberSoap ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "CyberSoap"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "SOAP web services client",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1",
    "xml-formatter": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pickywawa/cybersoap.git"
  },
  "homepage": "https://pickywawa.github.io/cybersoap/"
}
